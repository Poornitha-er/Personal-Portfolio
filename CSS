* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.6;
    color: #222;
    background: #fff;
}


/* Navigation */

header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: #fff;
    border-bottom: 1px solid #e5e5e5;
}

.navbar {
    max-width: 1200px;
    margin: auto;
    padding: 18px 30px;

    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-size: 22px;
    font-weight: bold;
}

.nav-links {
    list-style: none;

    display: flex;
    gap: 25px;
}

.nav-links a {
    text-decoration: none;
    color: #222;
    font-size: 14px;
    font-weight: 500;
}

.nav-links a:hover {
    color: #666;
}


/* Home */

.hero {
    min-height: 90vh;
    max-width: 1100px;
    margin: auto;
    padding: 120px 30px;

    display: flex;
    align-items: center;
}

.hero-content {
    max-width: 750px;
}

.intro {
    font-size: 18px;
    margin-bottom: 10px;
}

.hero h1 {
    font-size: 64px;
    line-height: 1.1;
    margin-bottom: 15px;
}

.hero h2 {
    font-size: 28px;
    font-weight: 500;
    margin-bottom: 25px;
}

.hero-content > p {
    font-size: 17px;
    color: #555;
    max-width: 700px;
}


/* Buttons */

.hero-buttons {
    display: flex;
    gap: 15px;
    margin-top: 30px;
}

.btn {
    display: inline-block;
    padding: 12px 24px;

    background: #222;
    color: #fff;

    text-decoration: none;
    border: 1px solid #222;

    transition: 0.3s;
}

.btn:hover {
    background: #fff;
    color: #222;
}

.btn.secondary {
    background: #fff;
    color: #222;
}

.btn.secondary:hover {
    background: #222;
    color: #fff;
}


/* Social Links */

.social-links {
    display: flex;
    gap: 25px;
    margin-top: 30px;
}

.social-links a {
    color: #333;
    text-decoration: none;
    font-weight: 500;
}

.social-links a:hover {
    text-decoration: underline;
}


/* Sections */

.section {
    padding: 90px 30px;
}

.container {
    max-width: 1100px;
    margin: auto;
}

.section-title {
    font-size: 36px;
    margin-bottom: 40px;
    position: relative;
}

.section-title::after {
    content: "";
    display: block;

    width: 50px;
    height: 3px;

    background: #222;

    margin-top: 10px;
}


/* About */

#about p {
    max-width: 850px;
    color: #555;
    margin-bottom: 20px;
    font-size: 16px;
}


/* Skills */

.skills-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
}

.skill-card {
    padding: 25px;
    border: 1px solid #ddd;

    text-align: center;
    font-weight: 600;

    transition: 0.3s;
}

.skill-card:hover {
    transform: translateY(-5px);
    border-color: #222;
}


/* Projects */

.projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
}

.project-card {
    border: 1px solid #ddd;
    padding: 30px;

    transition: 0.3s;
}

.project-card:hover {
    transform: translateY(-5px);
    border-color: #222;
}

.project-card h3 {
    font-size: 24px;
    margin-bottom: 8px;
}

.project-type {
    font-weight: 600;
    color: #666;
    margin-bottom: 15px;
}

.project-card > p:not(.project-type) {
    color: #555;
    margin-bottom: 20px;
}

.project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.project-tech span {
    border: 1px solid #ccc;
    padding: 5px 12px;
    font-size: 13px;
}


/* Experience */

.timeline {
    border-left: 2px solid #ddd;
    padding-left: 30px;
}

.timeline-item {
    margin-bottom: 45px;
    position: relative;
}

.timeline-item::before {
    content: "";

    position: absolute;
    left: -39px;
    top: 5px;

    width: 14px;
    height: 14px;

    background: #222;
    border-radius: 50%;
}

.timeline-item h3 {
    font-size: 22px;
    margin-bottom: 5px;
}

.timeline-item h4 {
    font-size: 16px;
    font-weight: 500;
    color: #555;
}

.date {
    margin: 8px 0;
    font-size: 14px;
    color: #777;
}

.timeline-item > p:not(.date) {
    color: #555;
}


/* Certifications */

.certificate-card {
    border: 1px solid #ddd;
    padding: 30px;
    max-width: 500px;
}

.certificate-card h3 {
    margin-bottom: 8px;
}

.certificate-card p {
    color: #666;
}


/* Contact */

.contact-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
}

.contact-card {
    border: 1px solid #ddd;
    padding: 25px;
}

.contact-card h3 {
    margin-bottom: 8px;
}

.contact-card a {
    color: #333;
    text-decoration: none;
    word-break: break-word;
}

.contact-card a:hover {
    text-decoration: underline;
}


/* Footer */

footer {
    text-align: center;
    padding: 30px;
    border-top: 1px solid #ddd;
    color: #666;
}


/* Responsive */

@media (max-width: 850px) {

    .navbar {
        flex-direction: column;
        gap: 15px;
    }

    .nav-links {
        flex-wrap: wrap;
        justify-content: center;
        gap: 15px;
    }

    .hero {
        min-height: auto;
        padding: 90px 25px;
    }

    .hero h1 {
        font-size: 48px;
    }

    .skills-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .projects-grid {
        grid-template-columns: 1fr;
    }

}


@media (max-width: 550px) {

    .section {
        padding: 70px 20px;
    }

    .hero {
        padding: 70px 20px;
    }

    .hero h1 {
        font-size: 40px;
    }

    .hero h2 {
        font-size: 22px;
    }

    .hero-buttons {
        flex-direction: column;
        align-items: flex-start;
    }

    .skills-grid {
        grid-template-columns: 1fr;
    }

    .contact-grid {
        grid-template-columns: 1fr;
    }

    .section-title {
        font-size: 30px;
    }

}
